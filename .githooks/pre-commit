#!/bin/sh
# Every commit: Ruby style, and, when a frontend or test file is staged,
# the JavaScript/TypeScript lint and the type check too. All code is
# linted before it is committed, not only before it is pushed (bin/check).
set -e

# Secrets first: a leaked value in a pushed commit cannot be taken back
# (.gitleaks.toml says what to do then). bin/setup installs gitleaks.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed; run bin/setup (or: brew install gitleaks)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --no-banner --redact

bundle exec rubocop

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(js|jsx|ts|tsx|mjs)$'; then
  npm run --silent lint
  npm run --silent typecheck
fi
