  def validate_socket_id(socket_id); end
end

# pkg:gem/pusher#lib/pusher/version.rb:2
Pusher::VERSION = T.let(T.unsafe(nil), String)

# Used to parse and authenticate WebHooks
#
# @example Sinatra
#   post '/webhooks' do
#     webhook = Pusher::WebHook.new(request)
#     if webhook.valid?
#       webhook.events.each do |event|
#         case event["name"]
#         when 'channel_occupied'
#           puts "Channel occupied: #{event["channel"]}"
#         when 'channel_vacated'
#           puts "Channel vacated: #{event["channel"]}"
#         end
#       end
#     else
#       status 401
#     end
#     return
#   end
#
# pkg:gem/pusher#lib/pusher/webhook.rb:25
class Pusher::WebHook
  # Provide either a Rack::Request or a Hash containing :key, :signature,
  # :body, and :content_type (optional)
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:31
  def initialize(request, client = T.unsafe(nil)); end

  # Access the parsed WebHook body
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:87
  def data; end

  # Array of events (as Hashes) contained inside the webhook
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:72
  def events; end

  # pkg:gem/pusher#lib/pusher/webhook.rb:26
  def key; end

  # pkg:gem/pusher#lib/pusher/webhook.rb:26
  def signature; end

  # The time at which the WebHook was initially triggered by Pusher, i.e.
  # when the event occurred
  #
  # @return [Time]
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:81
  def time; end

  # Returns whether the WebHook is valid by checking that the signature
  # matches the configured key & secret. In the case that the webhook is
  # invalid, the reason is logged
  #
  # @param extra_tokens [Hash] If you have extra tokens for your Pusher app, you can specify them so that they're used to attempt validation.
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:57
  def valid?(extra_tokens = T.unsafe(nil)); end

  private

  # Checks signature against secret and returns boolean
  #
  # pkg:gem/pusher#lib/pusher/webhook.rb:102
  def check_signature(secret); end
end
