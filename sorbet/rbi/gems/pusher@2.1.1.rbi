  # @param custom_string [String] Allows signing additional data
  # @return [String]
  #
  # @raise [Pusher::Error] if socket_id or custom_string invalid
  #
  # pkg:gem/pusher#lib/pusher/client.rb:512
  def authentication_string(socket_id, custom_string = T.unsafe(nil)); end

  # pkg:gem/pusher#lib/pusher/client.rb:489
  def configured?; end

  # JSON-encode the data if it's not a string
  #
  # pkg:gem/pusher#lib/pusher/client.rb:462
  def encode_data(data); end

  # Encrypts a message with a key derived from the master key and channel
  # name
  #
  # pkg:gem/pusher#lib/pusher/client.rb:469
  def encrypt(channel_name, encoded_data); end

  # pkg:gem/pusher#lib/pusher/client.rb:493
  def require_rbnacl; end

  # pkg:gem/pusher#lib/pusher/client.rb:447
  def trigger_batch_params(events); end

  # pkg:gem/pusher#lib/pusher/client.rb:429
  def trigger_params(channels, event_name, data, params); end

  # pkg:gem/pusher#lib/pusher/client.rb:524
  def user_data_valid?(data); end

  # pkg:gem/pusher#lib/pusher/client.rb:518
  def validate_user_data(user_data); end

  class << self
    # Loads the configuration from an url in the environment
    #
    # pkg:gem/pusher#lib/pusher/client.rb:19
    def from_env(key = T.unsafe(nil)); end

    # Loads the configuration from a url
    #
