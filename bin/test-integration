#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# Integration test orchestrator
#
# Seeds the test database with deterministic data, builds the frontend,
# boots a Rails test server, runs Playwright integration tests against
# the real backend, and cleans up on exit.
#
# Usage:
#   bin/test-integration              # run all integration tests
#   bin/test-integration auth.spec.js # run a specific test file
# ---------------------------------------------------------------------------

RAILS_PORT=3001
RAILS_PID=""
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

# The suite's frozen clock: seeds, the Rails test server, and the
# browser (tests/helpers/integration_setup.js) all see this date as
# today, so relative seed dates and screenshots are the same on any
# day the suite runs. config/initializers/integration_fake_time.rb
# reads it, test environment only. Thu 2026-01-15 matches the mocked
# e2e suite's frozen date.
#
# Set AFTER db:prepare below: Rails refuses migration timestamps that
# are later than "now", and with the clock frozen in the past every
# migration added since the fake date looks like it is from the
# future. Only the seed task and the server run frozen.
FAKE_TODAY="${INTEGRATION_FAKE_TODAY:-2026-01-15}"
unset INTEGRATION_FAKE_TODAY

cleanup() {
  if [ -n "$RAILS_PID" ]; then
    echo ""
    echo "Stopping Rails test server (PID $RAILS_PID)..."
    kill "$RAILS_PID" 2>/dev/null || true
    wait "$RAILS_PID" 2>/dev/null || true
  fi
  # Wipe integration seed data so RSpec finds a clean database.
  echo "Resetting test database..."
  psql -q -d comeals_test -c "TRUNCATE communities CASCADE" 2>/dev/null || true
}
trap cleanup EXIT

# ------------------------------------------------------------------
# 1. Prepare test database
# ------------------------------------------------------------------
echo "==> Preparing test database..."
# Full output on purpose: an up-to-date database prints almost nothing,
# and when preparation fails the error must be readable in CI logs.
RAILS_ENV=test bundle exec rails db:prepare

echo "==> Seeding integration test data (frozen at $FAKE_TODAY)..."
export INTEGRATION_FAKE_TODAY="$FAKE_TODAY"
RAILS_ENV=test bundle exec rails test:seed_integration

# ------------------------------------------------------------------
# 2. Build frontend
# ------------------------------------------------------------------
echo ""
if [ "${SKIP_BUILD:-}" = "1" ]; then
  echo "==> Reusing existing frontend build (SKIP_BUILD=1)"
else
  echo "==> Building frontend..."
  npm run build 2>&1 | tail -3
fi

# ------------------------------------------------------------------
# 3. Start Rails test server
# ------------------------------------------------------------------
echo ""

# Refuse to run if something else already holds the port. Without this
# check, our server dies on "address already in use", the health check
# below gets a friendly answer from whatever is squatting there, and
# the whole suite runs against a server built from other code. That
# happened: a test server left over from Aug 9 answered every run for
# three days, and its pre-slug-removal code turned the login test red.
if lsof -tiTCP:"$RAILS_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "ERROR: port $RAILS_PORT is already in use:"
  lsof -iTCP:"$RAILS_PORT" -sTCP:LISTEN -P
  echo "Kill that process (likely a leftover test server) and re-run."
  exit 1
fi

echo "==> Starting Rails test server on port $RAILS_PORT..."
SERVER_LOG="tmp/integration_server.log"
RAILS_ENV=test INTEGRATION_SERVER=1 bundle exec rails server -p "$RAILS_PORT" &>"$SERVER_LOG" &
RAILS_PID=$!

# Wait for server to be ready
echo -n "    Waiting for server"
for i in $(seq 1 30); do
  # Our server dying (crash, port stolen between the check above and
  # the bind) must fail the run — never fall through to a health check
  # that some other process might answer.
  if ! kill -0 "$RAILS_PID" 2>/dev/null; then
    echo " DIED"
    echo "ERROR: Rails server exited during startup. Its output ($SERVER_LOG):"
    tail -20 "$SERVER_LOG"
    exit 1
  fi
  if curl -sf "http://localhost:$RAILS_PORT/api/v1/version" &>/dev/null; then
    echo " ready!"
    break
  fi
  if [ "$i" -eq 30 ]; then
    echo " TIMEOUT"
    echo "ERROR: Rails server failed to start within 30 seconds. Its output ($SERVER_LOG):"
    tail -20 "$SERVER_LOG"
    exit 1
  fi
  echo -n "."
  sleep 1
done

# ------------------------------------------------------------------
# 4. Run Playwright integration tests
# ------------------------------------------------------------------
echo ""
echo "==> Running integration tests..."
echo ""

PLAYWRIGHT_ARGS=(--config playwright.integration.config.js)

# Pass through any extra arguments (e.g., specific test file)
if [ $# -gt 0 ]; then
  PLAYWRIGHT_ARGS+=("$@")
fi

npx playwright test "${PLAYWRIGHT_ARGS[@]}"
