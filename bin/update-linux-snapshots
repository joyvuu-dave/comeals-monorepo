#!/bin/bash
# Regenerate the Linux golden images for the visual suite, locally.
# The container mechanics live in bin/visual-linux, which CI also uses
# in compare mode.
set -euo pipefail
cd "$(dirname "$0")/.."

bin/visual-linux --update

echo
echo "Done. Review the changed PNGs, then commit them:"
echo "  git status tests/e2e/visual.spec.js-snapshots/"
echo
echo "A PNG that changed by a few bytes with no visible difference is"
echo "antialiasing inside the diff tolerance — discard it with git"
echo "checkout and keep the committed golden."
