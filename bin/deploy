#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Comeals Deploy Script
#
# Deploys the monorepo (Rails + React) to Heroku as a single app.
#
# Smart deploy logic:
#   1. Compares local HEAD vs Heroku's deployed SHA.
#      Skips if already up to date.
#   2. Diffs db/migrate/ between the deployed and local SHAs.
#      - If a migration was added or changed → maintenance deploy (scale
#        web and the worker to 0, push, scale up, and turn maintenance off
#        once web is up on the new release).
#      - If not → push deploy (brief downtime during restart). A deleted
#        migration does not count: production ran it, its version stays
#        in schema_migrations, and the release phase has nothing to run.
#   3. Refuses a database that is behind db/production_schema_version.txt,
#      before anything changes (check_database_not_behind).
#
# Heroku buildpack order: Node (Vite build) → Ruby (bundle + Sprockets).
#
# Which app: production (comeals-monorepo) unless DEPLOY_APP says
# otherwise. DEPLOY_APP=comeals-staging runs the same steps, in the same
# order, on the staging app, so a deploy can be tried there first:
#
#   DEPLOY_APP=comeals-staging bin/deploy
#
# On staging the script pushes to staging's own git address, not to the
# heroku remote (which points at production), checks only staging's
# address, files no GitHub issue, and first refuses a staging app that
# could send mail (COMEALS_STAGING, bin/lib/staging_forbidden_vars.sh).
# Any other value of DEPLOY_APP, an empty one included, is refused before
# anything runs.
#
# Every run writes everything it prints, Heroku's build output and the
# release phase output included, to tmp/deploy/deploy-<UTC time>-<app>.log,
# and ends with "Warnings seen during this deploy": each warning line once,
# known ones (docs/deploy-known-warnings.txt) in short and new ones in red.
#
# After the balance refresh, rake ledger:verify checks every settled
# balance against its source data. If it fails, the deploy stops and
# prints the Rollback workflow command to run.
#
# The smoke test signs in when it has credentials (bin/smoke). On
# production, bin/deploy reads SMOKE_EMAIL, SMOKE_PASSWORD,
# SMOKE_ADMIN_EMAIL and SMOKE_ADMIN_PASSWORD from .env when the
# environment does not set them (load_smoke_credentials).
# ==============================================================================

MAINTENANCE_ENABLED=false
DEPLOY_TIMESTAMP=""
NEEDS_MAINTENANCE=false
HEROKU_SHA=""
# The newest release before the push, and the release the push made.
RELEASE_BEFORE=""
NEW_RELEASE=""
# How many web dynos a maintenance deploy brings back. deploy_maintenance
# sets it from the count that ran before (#244).
WEB_COUNT=1
# The backup capture_backup took, for the rollback command.
BACKUP_ID=""
# True once rake ledger:verify failed after the push.
LEDGER_FAILED=false
# The app log lines check_logs read, for the warnings section.
APP_LOGS=""

# --yes (or DEPLOY_YES=1): proceed without the interactive
# confirmation. The automated pipeline (deploy.yml) runs with this;
# every gate still runs — the flag only removes the question.
if [ "${1:-}" = "--yes" ]; then
  DEPLOY_YES=1
fi

# --- Output helpers (shared with bin/check) -----------------------------------

. "$(dirname "$0")/lib/output.sh"
. "$(dirname "$0")/lib/json.sh"
. "$(dirname "$0")/lib/wait_until_stopped.sh"
. "$(dirname "$0")/lib/staging_forbidden_vars.sh"

# --- The target app -----------------------------------------------------------

# Only unset means production. An empty DEPLOY_APP is refused like any
# other unknown value, so a variable that was meant to say staging and is
# empty by mistake does not deploy to production.
APP="${DEPLOY_APP-comeals-monorepo}"
case "$APP" in
  comeals-monorepo)
    APP_URL="https://comeals.com"
    # Where git pushes and fetches: the heroku remote, checked in
    # preflight_environment.
    GIT_TARGET="heroku"
    # Every public hostname, not just the apex: config.hosts in
    # production.rb serves only a fixed list, so a hostname missing from
    # that list is an outage for that hostname — and the health check is
    # what catches it during the deploy instead of days later. Keep the
    # two lists in step.
    HEALTH_URLS=(
      "$APP_URL"
      "$APP_URL/api/v1/version"
      "https://www.comeals.com"
      "https://admin.comeals.com"
      "https://api.comeals.com"
      "https://comeals-monorepo-b68ce4e5c3d4.herokuapp.com"
    )
    ;;
  comeals-staging)
    APP_URL="https://comeals-staging-ad51b8a1eb64.herokuapp.com"
    # Staging's own git address. Never the heroku remote: that one points
    # at production.
    GIT_TARGET="https://git.heroku.com/comeals-staging.git"
    # Staging has only its herokuapp hostname (EXTRA_HOSTS on the app).
    HEALTH_URLS=("$APP_URL" "$APP_URL/api/v1/version")
    ;;
  *)
    fail "DEPLOY_APP is \"$APP\". It must be comeals-monorepo or comeals-staging. Nothing was changed."
    exit 1
    ;;
esac

# --- The deploy log -----------------------------------------------------------

# Everything this run prints goes to the terminal, as before, and to one
# file, so the output Heroku sends back (the build, the release phase,
# the one-off dynos) is kept after the terminal is closed. Standard error
# goes the same way, in the same order. Nothing the script prints holds a
# password: the smoke credentials go to bin/smoke only through the
# environment, and bin/smoke never prints them.
#
# tee ignores Ctrl-C, so the recovery banner below still reaches the
# file and the terminal when the person running the deploy stops it.
DEPLOY_LOG="tmp/deploy/deploy-$(date -u +%Y%m%dT%H%M%SZ)-$APP.log"
KNOWN_WARNINGS="$(dirname "$0")/../docs/deploy-known-warnings.txt"
mkdir -p tmp/deploy
exec {TERMINAL_OUT}>&1 {TERMINAL_ERR}>&2
exec > >(trap '' INT; exec tee -a "$DEPLOY_LOG") 2>&1
TEE_PID=$!

# Runs last, on success and on failure. The warning search reads the
# whole file, so the first tee must have written all of it: give the
# terminal back, wait for tee to end, search, and only then print the
# section to the terminal and add it to the file.
finish_deploy_log() {
  exec 1>&"$TERMINAL_OUT" 2>&"$TERMINAL_ERR"
  wait "$TEE_PID"
  local report searched=true
  report=$(printf '%s\n' "$APP_LOGS" \
    | python3 "$(dirname "$0")/lib/deploy-warnings" "$APP" "$KNOWN_WARNINGS" "$DEPLOY_LOG" - 2>&1) || searched=false
  {
    step "Warnings seen during this deploy"
    printf '%s\n' "$report"
    if [ "$searched" = false ]; then
      warn "Could not search this run's output for warnings. Read $DEPLOY_LOG for lines with WARN in them."
    fi
    echo
    info "The whole output of this run is in $DEPLOY_LOG (keep this file)."
  } 2>&1 | tee -a "$DEPLOY_LOG"
}

# --- Cleanup trap -------------------------------------------------------------

cleanup() {
  local exit_code=$?
  # Nothing here may change the exit status: a grep that finds nothing
  # must not end the trap.
  set +e
  # After a failed ledger check, the way out is the rollback it printed,
  # not scaling the new code back up.
  if [ $exit_code -ne 0 ] && [ "$MAINTENANCE_ENABLED" = true ] && [ "$LEDGER_FAILED" = false ]; then
    echo
    red "============================================"
    red "  DEPLOY FAILED — MANUAL RECOVERY REQUIRED"
    red "============================================"
    echo
    yellow "App may still be in maintenance mode."
    yellow "The web and worker dynos may be scaled to 0."
    yellow "Investigate the failure, then manually run:"
    echo
    echo "  heroku ps:scale worker=1 -a $APP"
    echo "  heroku ps:scale web=$WEB_COUNT -a $APP"
    echo "  heroku maintenance:off -a $APP"
    echo
    yellow "Turn maintenance off last, once heroku ps -a $APP shows web up."
    echo
  fi
  finish_deploy_log
  exit "$exit_code"
}
trap cleanup EXIT

# --- Smoke credentials ----------------------------------------------------------

# The value of NAME in .env, the last line that sets it, without the
# quotes around it. Empty when .env or the line is missing. Reads the
# file as text and runs none of it, so nothing else in .env reaches this
# script.
env_file_value() {
  local name=$1 line value=""
  [ -f .env ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$name="* | "export $name="*) value=${line#*=} ;;
    esac
  done <.env
  if [[ $value =~ ^\'(.*)\'$ ]] || [[ $value =~ ^\"(.*)\"$ ]]; then
    value=${BASH_REMATCH[1]}
  fi
  printf '%s' "$value"
}

# On production, bin/smoke signs in as a resident and as an admin when it
# has these four. A variable already in the environment wins; then the
# SMOKE_* line in .env; then the owner's own names for the same accounts,
# which is what the owner's .env has: RESIDENT_EMAIL, RESIDENT_PASSWORD,
# ADMIN_EMAIL and ADMIN_PASSWORD. (RESIDENT_USER and ADMIN_USER are not
# read.) Staging signs in only with its own smoke resident, which
# bin/staging-rehearsal makes, so .env is not read there.
load_smoke_credentials() {
  [ "$APP" = comeals-monorepo ] || return 0
  local pair var value
  for pair in SMOKE_EMAIL:RESIDENT_EMAIL SMOKE_PASSWORD:RESIDENT_PASSWORD \
    SMOKE_ADMIN_EMAIL:ADMIN_EMAIL SMOKE_ADMIN_PASSWORD:ADMIN_PASSWORD; do
    var=${pair%%:*}
    [ -z "${!var:-}" ] || continue
    value=$(env_file_value "$var")
    [ -n "$value" ] || value=$(env_file_value "${pair#*:}")
    [ -z "$value" ] || export "$var=$value"
  done
}
load_smoke_credentials

# --- Pre-flight checks --------------------------------------------------------

preflight_environment() {
  step "Pre-flight: environment"

  if ! command -v heroku &>/dev/null; then
    fail "heroku CLI not found in PATH"
    exit 1
  fi
  ok "heroku CLI found"

  if ! heroku auth:whoami &>/dev/null; then
    fail "Not logged into Heroku (run: heroku login)"
    exit 1
  fi
  local user
  user=$(heroku auth:whoami 2>/dev/null)
  ok "Logged into Heroku as $user"

  if [ "$APP" = comeals-staging ]; then
    ok "Pushes go to $GIT_TARGET"
    check_staging_cannot_reach_people
    return
  fi

  local remote_url
  remote_url=$(git remote get-url heroku 2>/dev/null || true)
  if [ -z "$remote_url" ]; then
    fail "No 'heroku' git remote"
    info "Run: heroku git:remote -a $APP"
    exit 1
  fi
  # `heroku git:remote -a <another app>` changes where the remote points.
  # Every heroku command below names $APP, but the push goes to the
  # remote, so the two must be the same app. The https address, or the
  # older ssh one.
  case "$remote_url" in
    "https://git.heroku.com/$APP.git" | "git@heroku.com:$APP.git") ;;
    *)
      fail "The heroku remote points at $remote_url, not at https://git.heroku.com/$APP.git"
      info "Run: heroku git:remote -a $APP"
      exit 1
      ;;
  esac
  ok "heroku remote -> $remote_url"
}

# Staging holds a copy of the production database, with real residents'
# email addresses, and the deploy starts the worker dyno, whose jobs send
# mail. So refuse unless the app says it is staging (COMEALS_STAGING
# turns mail and Pusher off) and has none of the forbidden config vars.
# bin/staging-rehearsal runs the same check first.
check_staging_cannot_reach_people() {
  local flag config_keys var
  flag=$(heroku config:get COMEALS_STAGING -a "$APP")
  # The app reads COMEALS_STAGING with present?, so a blank value turns
  # the guards off, the same as no value.
  if [ -z "${flag//[[:space:]]/}" ]; then
    fail "COMEALS_STAGING is not set or is blank on $APP — its mail and Pusher guards are off"
    exit 1
  fi
  config_keys=$(heroku config -a "$APP" --json | json "'\n'.join(d.keys())")
  for var in "${STAGING_FORBIDDEN_VARS[@]}"; do
    if grep -qx "$var" <<< "$config_keys"; then
      fail "$var is set on $APP — staging must not have it"
      exit 1
    fi
  done
  ok "$APP cannot send mail or push (COMEALS_STAGING set, no forbidden config vars)"
}

preflight_repo() {
  step "Pre-flight: repository"

  local branch
  branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$branch" != "main" ]; then
    fail "On branch '$branch', expected 'main'"
    exit 1
  fi
  ok "On main branch"

  if [ -n "$(git status --porcelain)" ]; then
    fail "Uncommitted changes detected:"
    git status --short
    exit 1
  fi
  ok "Working tree clean"

  info "Fetching from origin..."
  git fetch origin -p -P --quiet

  local ahead behind
  ahead=$(git rev-list origin/main..HEAD --count)
  behind=$(git rev-list HEAD..origin/main --count)

  if [ "$ahead" -gt 0 ]; then
    fail "$ahead unpushed commit(s) on main"
    exit 1
  fi
  ok "No unpushed commits"

  if [ "$behind" -gt 0 ]; then
    info "Local is $behind commit(s) behind origin/main, pulling..."
    git pull --ff-only --quiet
    ok "Pulled $behind commit(s)"
  else
    ok "Up to date with origin/main"
  fi
}

# Refuse to deploy a commit whose GitHub CI is not green. Runs after
# preflight_repo, so HEAD here is exactly the commit that would ship.
# preflight_quality still runs the fast local checks afterwards; this
# gate is what brings the slow suites (e2e, visual, integration) into
# the deploy decision without re-running them locally.
# DEPLOY_WITHOUT_CI=1 skips the gate — for a GitHub outage, not for a
# red build.
preflight_ci() {
  step "Pre-flight: CI status"

  if [ "${DEPLOY_WITHOUT_CI:-}" = "1" ]; then
    # The break-glass. Legitimate only when the pipeline itself is the
    # casualty: GitHub or CI is down AND rollback cannot fix production.
    # It is hard to use by mistake, on purpose: a typed phrase, and a
    # follow-up issue so every use gets looked at afterward. A red build
    # is never a reason.
    warn "DEPLOY_WITHOUT_CI=1 — the break-glass. Every CI result will be ignored."
    warn "Legitimate only when GitHub/CI is itself down and rollback cannot fix prod."
    if [ ! -t 0 ]; then
      fail "The break-glass needs a terminal to type the confirmation phrase."
      exit 1
    fi
    printf "Type 'break glass' to continue: "
    read -r phrase
    if [ "$phrase" != "break glass" ]; then
      info "Aborted."
      exit 1
    fi
    # An issue on GitHub is for the people who look after production. A
    # deploy to staging is a rehearsal and needs none.
    if [ "$APP" = comeals-staging ]; then
      info "No follow-up issue for a deploy to $APP"
      return
    fi
    local issue_body="bin/deploy ran with DEPLOY_WITHOUT_CI=1 on $(date -u +%Y-%m-%d) at commit $(git rev-parse HEAD).

Every break-glass use gets reviewed. Answer in this issue: what was broken, why rollback could not fix it, and what would have let the normal pipeline handle it."
    if command -v gh >/dev/null 2>&1 \
      && gh issue create --title "Break-glass deploy on $(date -u +%Y-%m-%d)" \
        --body "$issue_body" >/dev/null 2>&1; then
      ok "Follow-up issue filed"
    else
      warn "Could not file the follow-up issue (GitHub down?) — file one by hand"
    fi
    return
  fi

  if ! command -v gh &>/dev/null; then
    fail "gh CLI not found — needed to read CI status (DEPLOY_WITHOUT_CI=1 overrides)"
    exit 1
  fi

  local sha
  sha=$(git rev-parse HEAD)

  # One line per check run: name|status|conclusion. The API returns
  # the latest run per check, so retried jobs report their newest try.
  local runs
  if ! runs=$(gh api "repos/{owner}/{repo}/commits/${sha}/check-runs" --paginate \
    --jq '.check_runs[] | "\(.name)|\(.status)|\(.conclusion // "pending")"'); then
    fail "Could not read check runs from GitHub (DEPLOY_WITHOUT_CI=1 overrides)"
    exit 1
  fi

  if [ -z "$runs" ]; then
    fail "No CI runs found for ${sha:0:7} — push and let CI finish before deploying"
    exit 1
  fi

  local bad=0 name status conclusion
  while IFS='|' read -r name status conclusion; do
    if [ "$status" != "completed" ]; then
      fail "still running: $name"
      bad=1
    elif [ "$conclusion" != "success" ] && [ "$conclusion" != "neutral" ] && [ "$conclusion" != "skipped" ]; then
      fail "$conclusion: $name"
      bad=1
    fi
  done <<< "$runs"

  if [ "$bad" -ne 0 ]; then
    fail "CI is not green for ${sha:0:7}. Fix or wait, then deploy."
    exit 1
  fi

  ok "All CI checks green for ${sha:0:7}"
}

preflight_quality() {
  step "Pre-flight: linting & tests"

  # ESLint, Vitest and bin/smoke run with node_modules, and nothing else
  # makes it match package-lock.json: the pull above can change the
  # lockfile, and a checkout's node_modules can be older still. On
  # 2026-10-22 an old Playwright could not start its browser, and the smoke
  # test asked for a rollback of a good deploy (#241). So install exactly
  # what the lockfile names, as CI and the Deploy workflow do. npm ci
  # replaces node_modules, so a bin/dev running from this checkout needs a
  # restart afterwards.
  info "Installing the npm packages package-lock.json names (npm ci)..."
  npm ci
  ok "node_modules matches package-lock.json"

  # The browser build bin/smoke needs belongs to the Playwright version
  # npm ci just installed. Installing it here, before anything changes in
  # production, means a failed download stops the deploy now instead of
  # looking like a broken app after it.
  info "Installing the browser bin/smoke uses (Playwright Chromium)..."
  npx playwright install chromium
  ok "Playwright Chromium installed"

  info "Running RuboCop..."
  bundle exec rubocop --parallel
  ok "RuboCop passed"

  info "Running RSpec..."
  bundle exec rspec
  ok "RSpec passed"

  info "Running ESLint..."
  npm run lint
  ok "ESLint passed"

  info "Running Vitest..."
  npm test
  ok "Vitest passed"
}

# --- Deploy detection ---------------------------------------------------------

detect_deploy_needs() {
  step "Detecting what needs to deploy"

  local local_sha heroku_sha
  local_sha=$(git rev-parse HEAD)
  # The commit the running release was built from. Not Heroku's git main:
  # after a rollback that is the commit that was rolled back, and a
  # migration between the two would be missed.
  heroku_sha=$(heroku config:get HEROKU_SLUG_COMMIT -a "$APP" 2>/dev/null || true)

  if [ -n "$heroku_sha" ] && [ "$heroku_sha" = "$local_sha" ]; then
    ok "Already up to date (${local_sha:0:7})"
    return 1
  fi

  # A rollback changes the release that runs, not Heroku's git. So after
  # one, Heroku's git main can already be this commit while an older
  # release runs, and a push would print "Everything up-to-date", build
  # nothing and make no release (#242). Stop now, before anything changes.
  local git_main
  if ! git_main=$(git ls-remote "$GIT_TARGET" refs/heads/main); then
    fail "Cannot read the main branch of Heroku's git (git ls-remote $GIT_TARGET)"
    exit 1
  fi
  if [ "${git_main%%[[:space:]]*}" = "$local_sha" ]; then
    local running=${heroku_sha:0:7}
    fail "Heroku's git already has ${local_sha:0:7} on main, but $APP runs ${running:-a commit it cannot read}. A push would build nothing."
    info "A rollback changes the release that runs, not what Heroku's git holds."
    info "To deploy this code again, see \"Deploying a commit again after a rollback\" in docs/runbooks/undo-a-deploy.md."
    exit 1
  fi

  if [ -z "$heroku_sha" ]; then
    warn "Cannot read Heroku SHA (first deploy or endpoint unreachable)"
    info "Will deploy with maintenance mode for safety"
    NEEDS_MAINTENANCE=true
    return 0
  fi

  info "heroku=${heroku_sha:0:7} -> local=${local_sha:0:7}"
  HEROKU_SHA="$heroku_sha"
  return 0
}

detect_pending_migrations() {
  step "Checking for pending migrations"

  if [ -z "$HEROKU_SHA" ]; then
    return
  fi

  if ! git cat-file -e "$HEROKU_SHA" 2>/dev/null; then
    info "Heroku SHA not in local history — fetching from Heroku..."
    if git fetch "$GIT_TARGET" main --quiet 2>/dev/null; then
      ok "Fetched Heroku main branch"
    else
      warn "Cannot fetch from Heroku — assuming migrations needed"
      NEEDS_MAINTENANCE=true
      return
    fi

    if ! git cat-file -e "$HEROKU_SHA" 2>/dev/null; then
      warn "Heroku SHA still not in object store — assuming migrations needed"
      NEEDS_MAINTENANCE=true
      return
    fi
  fi

  # Every file added or changed, never a deleted one: after a deploy the
  # migrations production ran are deleted, and that changes nothing in
  # the database. --no-renames, because git would call a deleted migration
  # and a new one with nearly the same text a rename. Only a file named
  # <version>_<name>.rb counts, because db:migrate reads only those: an
  # empty db/migrate/ holds a .keep file so git keeps the folder.
  local changed_files migration_diff
  if ! changed_files=$(git diff --name-only --no-renames --diff-filter=d "$HEROKU_SHA" HEAD -- db/migrate/ 2>/dev/null); then
    warn "git diff failed — assuming migrations needed"
    NEEDS_MAINTENANCE=true
    return
  fi
  migration_diff=$(printf '%s\n' "$changed_files" | grep -E '^db/migrate/[0-9]+_[^/]+\.rb$' || true)

  if [ -n "$migration_diff" ]; then
    NEEDS_MAINTENANCE=true
    warn "Migration changes detected — maintenance deploy required:"
    echo "$migration_diff" | while IFS= read -r f; do
      info "  $f"
    done
  else
    ok "No new or changed migration — push deploy"
  fi
}

# After each deploy that runs migrations, the migrations production ran
# are deleted from db/migrate/, and db/production_schema_version.txt names
# the newest of them. A database whose newest migration is older (one
# restored from an older backup) needs migrations that no longer exist,
# so the release phase's db:migrate would run nothing, and the new code
# would run without the tables it needs (staging, 2026-10-24). The release
# phase refuses such a database (deploy:verify_schema_version in the
# Procfile, lib/squashed_migrations_check.rb, which says the same words).
# This asks first, so the deploy stops before the slow local checks, the
# backup and maintenance. A database with no schema_migrations table, or
# no row in it, has run no migration: it is new, and goes on.
# Versions are compared as numbers, as Rails does.
SCHEMA_VERSION_SQL="SELECT 'newest=' || coalesce(max(version::bigint)::text, 'none') AS schema FROM schema_migrations"

check_database_not_behind() {
  step "Pre-flight: the database has run the deleted migrations"

  local file=db/production_schema_version.txt versions squashed out newest
  versions=$(grep -v -e '^#' -e '^[[:space:]]*$' "$file" 2>/dev/null) || true
  if ! [[ $versions =~ ^[0-9]{14}$ ]]; then
    fail "$file must hold one version of 14 digits. Nothing was changed."
    exit 1
  fi
  squashed=$versions

  if out=$(heroku pg:psql -c "$SCHEMA_VERSION_SQL" -a "$APP" 2>&1) && [[ $out =~ newest=([0-9]+|none) ]]; then
    newest=${BASH_REMATCH[1]}
  elif [[ $out == *'relation "schema_migrations" does not exist'* ]]; then
    newest=none
  else
    # The last line that is not blank, which is where psql and the
    # Heroku CLI put the error.
    out=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1) || true
    fail "Could not read the newest migration in the database of $APP (${out:-no output}). Nothing was changed."
    exit 1
  fi
  if [ "$newest" = none ]; then
    ok "The database has run no migration, so it is new"
    return
  fi
  if [ "$newest" -lt "$squashed" ]; then
    fail "The database is behind $file. Its newest migration is $newest, but the file says $squashed: the migrations up to $squashed were deleted from db/migrate/ after production ran them. db:migrate cannot run a migration that has no file, so this code would run on a database without the tables and columns those migrations made. Do one of these: restore a backup taken after production ran migration $squashed, or deploy a commit whose $file is $newest or older (that commit still has the migration files)."
    info "Nothing was changed."
    exit 1
  fi
  ok "The database has run migration $newest, which is not behind $file ($squashed)"
}

# --- Deploy functions ---------------------------------------------------------

enable_maintenance() {
  step "Enabling maintenance mode"
  heroku maintenance:on -a "$APP"
  ok "$APP maintenance ON"
  MAINTENANCE_ENABLED=true
}

disable_maintenance() {
  step "Disabling maintenance mode"
  heroku maintenance:off -a "$APP"
  ok "$APP maintenance OFF"
  MAINTENANCE_ENABLED=false
}

# Some data-fix migrations write what they deleted only to the release
# phase output, which only Heroku holds. So save it to a file under
# tmp/deploy/ that the person running the deploy keeps. The release has
# already run by now, so a failure here does not stop the deploy: it says
# how to save the output by hand.
RELEASE_OUTPUT_FILE=""

save_release_output() {
  RELEASE_OUTPUT_FILE="tmp/deploy/release-output-$(date -u +%Y%m%dT%H%M%SZ).txt"
  mkdir -p tmp/deploy
  if heroku releases:output -a "$APP" >"$RELEASE_OUTPUT_FILE" 2>&1; then
    ok "Release phase output saved to $RELEASE_OUTPUT_FILE (keep this file)"
    info "Release phase output:"
    local line
    while IFS= read -r line || [ -n "$line" ]; do
      echo "      $line"
    done <"$RELEASE_OUTPUT_FILE"
  else
    warn "Could not read the release phase output. Save it by hand now:"
    warn "  heroku releases:output -a $APP > $RELEASE_OUTPUT_FILE"
  fi
}

# The newest release's version, before the push.
read_release_before() {
  RELEASE_BEFORE=$(heroku releases -a "$APP" --json | json "d[0]['version']")
}

# git push exits 0 even when the release phase fails (bin/staging-rehearsal
# saw this on 2026-08-17). Ask Heroku what the newest release did, and stop
# before the web dyno comes back up. Wait while the release is still pending.
#
# git push also exits 0 when it builds nothing ("Everything up-to-date").
# The newest release is then an older one, perhaps a rollback that
# succeeded (#242), so check that the push made a new release, and that
# the release runs this commit.
check_release_status() {
  local status="" version="" release tries=0
  while [ "$tries" -lt 36 ]; do
    release=$(heroku releases -a "$APP" --json | json "'%s %s' % (d[0]['version'], d[0]['status'])")
    version=${release%% *}
    status=${release#* }
    if [ "$status" != "pending" ]; then
      break
    fi
    tries=$((tries + 1))
    sleep 5
  done
  if [ "$version" = "$RELEASE_BEFORE" ]; then
    fail "The push made no new release: the newest release of $APP is still v$version."
    info "Heroku's git may have had this commit already. Check: heroku releases -a $APP"
    if [ "$MAINTENANCE_ENABLED" = true ]; then
      info "Nothing was deployed and no migration ran. It is safe to bring the old code back up with the commands below."
    fi
    exit 1
  fi
  NEW_RELEASE=$version
  save_release_output
  if [ "$status" != "succeeded" ]; then
    fail "The release phase did not succeed (status: $status). Its output is above."
    if [ "$MAINTENANCE_ENABLED" = true ]; then
      info "Maintenance stays on and web and the worker stay at 0. Do not scale them up until you know which migrations ran: the old code may not work on the new schema."
    fi
    exit 1
  fi

  local sha running
  sha=$(git rev-parse HEAD)
  running=$(heroku config:get HEROKU_SLUG_COMMIT -a "$APP")
  if [ "$running" != "$sha" ]; then
    fail "Release v$version succeeded, but $APP runs ${running:0:7}, not ${sha:0:7}."
    info "A rollback or another deploy may have run at the same time. Check: heroku releases -a $APP"
    exit 1
  fi
  ok "Release phase succeeded (v$version runs ${sha:0:7})"
}

# Heroku marks a web dyno "up" once the process listens on its port, and
# Puma (one process, no workers: config/puma.rb) listens only after it
# has loaded the app. So a web dyno that is up on the new release can
# answer. The app itself cannot be asked: while maintenance is on, Heroku
# answers every request with the maintenance page. So wait for "up" on
# the new release, for at most 3 minutes; a web dyno that does not boot
# within 60 seconds is restarted by Heroku, so that is room for two boots.
# The health check after maintenance goes off then asks the app itself.
wait_for_web() {
  info "Waiting for web to be up on v$NEW_RELEASE..."
  local states state ready tries=0
  while :; do
    # The state of each web dyno on the new release ("starting up").
    # Ready when there is one and every one is up.
    states=$(heroku ps -a "$APP" --json | json "' '.join(p['state'] for p in d \
      if p['type'] == 'web' and str(p['release']['version']) == '$NEW_RELEASE')")
    ready=false
    if [ -n "$states" ]; then
      ready=true
      for state in $states; do
        [ "$state" = up ] || ready=false
      done
    fi
    if [ "$ready" = true ]; then
      break
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 36 ]; then
      fail "Web is not up on v$NEW_RELEASE after 3 minutes. Maintenance stays on."
      info "Find out why: heroku ps -a $APP ; heroku logs -a $APP --dyno web -n 200"
      info "When heroku ps shows web up on v$NEW_RELEASE, run: heroku maintenance:off -a $APP"
      info "Then check the site: bin/smoke $APP_URL"
      exit 1
    fi
    info "web on v$NEW_RELEASE: ${states:-no dyno yet} — waiting ($tries/36)"
    sleep 5
  done
  ok "Web is up on v$NEW_RELEASE"
}

# The push restarts a worker dyno that runs, but one at 0 stays at 0: on
# the first deploy whose release has a worker process type, and on the
# first after a rollback to a release without one. So scale it to 1 after
# every push. When it already runs, this asks for the count it has.
start_worker() {
  info "Starting the worker dyno (Solid Queue)..."
  heroku ps:scale worker=1 -a "$APP"
  ok "Worker dyno running"
}

deploy_push() {
  step "Deploying ($APP)"

  info "Pushing main to Heroku..."
  git push "$GIT_TARGET" main --force
  ok "Code pushed"
  check_release_status

  post_deploy_tasks
  start_worker
}

# No job may run while the migrations run, so the worker stops with web,
# and the push waits until no web or worker dyno and no Solid Queue
# process is left (bin/lib/wait_until_stopped.sh).
# A release from before the worker dyno has no worker process type, and
# Heroku refuses to scale one, so ask Heroku first ("web=1:Basic
# worker=1:Basic").
#
# After the release, the worker starts after the cache clear and the
# balance recalculation: its boot catch-up (RecurringCatchUp) then finds
# the fresh balance run and does not queue a second one beside it. Web
# starts last, still behind maintenance mode.
deploy_maintenance() {
  step "Deploying — maintenance ($APP)"

  local formation
  formation=$(heroku ps:scale -a "$APP")
  # Bring back as many web dynos as run now (#244). The formation is the
  # count Heroku keeps running, which is what ps:scale sets back. With
  # none, bring back one: a deploy must leave the site serving.
  if [[ " $formation" =~ \ web=([0-9]+) ]] && [ "${BASH_REMATCH[1]}" -gt 0 ]; then
    WEB_COUNT=${BASH_REMATCH[1]}
  else
    warn "Web ran 0 dynos before the deploy. It will come back as 1, so the site serves after the deploy."
  fi
  if [[ " $formation" == *" worker="* ]]; then
    info "Scaling web and worker dynos to 0..."
    heroku ps:scale web=0 worker=0 -a "$APP"
    ok "Web and worker dynos scaled to 0"
  else
    info "Scaling web dynos to 0 (the running release has no worker dyno)..."
    heroku ps:scale web=0 -a "$APP"
    ok "Web dynos scaled to 0"
  fi
  # No process of the old code may run beside the migrations. heroku ps
  # can list no worker while a worker process still runs Solid Queue
  # (#245), so this also waits for the Solid Queue heartbeats to stop.
  if ! wait_until_stopped "$APP"; then
    fail "Nothing was pushed, so no migration ran. Maintenance stays on."
    info "Find out what still runs: heroku ps -a $APP ; heroku logs -a $APP --dyno worker -n 200"
    info "and: heroku pg:psql -a $APP -c \"SELECT kind, hostname, pid, last_heartbeat_at FROM solid_queue_processes\""
    info "When nothing runs, run bin/deploy again. To give up the deploy instead, run the commands below."
    exit 1
  fi

  info "Pushing main to Heroku (release phase runs migrations)..."
  git push "$GIT_TARGET" main --force
  ok "Code pushed"
  check_release_status

  post_deploy_tasks
  start_worker

  info "Scaling web back up to $WEB_COUNT dyno(s)..."
  heroku ps:scale "web=$WEB_COUNT" -a "$APP"
  wait_for_web
}

post_deploy_tasks() {
  info "Clearing the cache..."
  if heroku run --exit-code bin/rails runner 'Rails.cache.clear' -a "$APP"; then
    ok "Cache flushed"
  else
    warn "Cache flush failed — stale entries may persist until naturally invalidated"
  fi

  info "Running billing:recalculate..."
  if heroku run --exit-code bin/rake billing:recalculate -a "$APP"; then
    ok "Billing recalculated"
  else
    warn "billing:recalculate failed — balances may be stale until next daily run"
  fi

  check_ledger
}

# Every settled balance against its source data (rake ledger:verify, the
# same check VerifyLedgerJob runs each night). It runs before the worker
# and, in a maintenance deploy, before web, so a wrong ledger stops the
# deploy while nobody can use the site.
check_ledger() {
  info "Checking the ledger (ledger:verify)..."
  if heroku run --exit-code bin/rake ledger:verify -a "$APP"; then
    ok "Ledger check passed"
    return 0
  fi

  LEDGER_FAILED=true
  local sha reason
  sha=$(git rev-parse --short HEAD)
  reason="The ledger check failed after the deploy of $sha"
  echo
  red "============================================"
  red "  THE LEDGER CHECK FAILED after the deploy"
  red "============================================"
  fail "rake ledger:verify found settled balances that do not match their source data. Its output is above."
  info "If the nightly check already failed before this deploy (admin: Ledger Checks), the deploy may not be the cause."
  if [ "$MAINTENANCE_ENABLED" = true ]; then
    info "Maintenance is on, and web and the worker are at 0: nobody can use the site. Leave it so."
    info "Migrations ran, so undo the deploy with the backup taken before it. Run the Rollback workflow:"
    echo
    echo "  gh workflow run rollback.yml --ref main -f app=$APP -f release=v$RELEASE_BEFORE -f backup=$BACKUP_ID -f reason=\"$reason\""
    echo
    info "It restores the backup, rolls back the code, and turns maintenance off (docs/runbooks/undo-a-deploy.md)."
  else
    info "Maintenance is off: $APP serves the new code now."
    info "No migration ran, so the code can go back alone. Run the Rollback workflow:"
    echo
    echo "  gh workflow run rollback.yml --ref main -f app=$APP -f release=v$RELEASE_BEFORE -f reason=\"$reason\""
    echo
    info "To also put the database back as it was before the deploy (this loses every write since), add: -f backup=$BACKUP_ID"
  fi
  exit 1
}

capture_backup() {
  step "Capturing database backup"
  heroku pg:backups:capture -a "$APP"
  ok "Backup complete"

  local backup_info
  backup_info=$(heroku pg:backups:info -a "$APP" 2>&1 || true)
  info "$backup_info"
  BACKUP_ID="\"<the newest backup in: heroku pg:backups -a $APP>\""
  local backup_line='=== Backup ([a-z0-9]+)'
  if [[ $backup_info =~ $backup_line ]]; then
    BACKUP_ID=${BASH_REMATCH[1]}
  fi
}

# --- Post-deploy checks ------------------------------------------------------

check_logs() {
  step "Checking post-deploy logs"

  local logs
  logs=$(heroku logs -n 200 -s app -a "$APP" 2>&1 || true)

  local app_logs
  app_logs=$(echo "$logs" | awk -v ts="$DEPLOY_TIMESTAMP" '$1 >= ts' || true)
  # All of them, for the warnings section at the end.
  APP_LOGS=$app_logs

  if [ -z "$app_logs" ]; then
    ok "No application log output since deploy"
    return 0
  fi

  local issues=""

  local errors
  errors=$(echo "$app_logs" | grep -E "(ERROR|FATAL|RuntimeError|NoMethodError|NameError|TypeError|ArgumentError|PG::|Errno::)" || true)
  if [ -n "$errors" ]; then
    issues+="$errors"$'\n'
  fi

  local warnings
  warnings=$(echo "$app_logs" | grep -i -E "(WARN|DEPRECAT)" || true)
  if [ -n "$warnings" ]; then
    issues+="$warnings"$'\n'
  fi

  if [ -n "$issues" ]; then
    warn "Issues found in logs:"
    echo "$issues" | head -30 | while IFS= read -r line; do
      if [ -n "$line" ]; then echo "      $line"; fi
    done
    local total
    total=$(echo "$issues" | grep -c . || true)
    if [ "$total" -gt 30 ]; then
      warn "...and $((total - 30)) more (run: heroku logs -n 500 -a $APP)"
    fi
  else
    ok "No errors, warnings, or deprecations found"
  fi
}

# Drive the live site with a real browser (bin/smoke): login page,
# and with SMOKE_EMAIL/SMOKE_PASSWORD set, login + calendar on a DST
# month + meal page; with SMOKE_ADMIN_EMAIL/SMOKE_ADMIN_PASSWORD set, the
# admin dashboard and the reconciliations page. curl proves the server
# answers; this proves the app runs. A failure here means the deploy is
# bad — roll back. On production a missing credential is named, because
# the checks it would run are then skipped.
run_smoke() {
  step "Browser smoke test"

  if [ "$APP" = comeals-monorepo ]; then
    local var missing=()
    for var in SMOKE_EMAIL SMOKE_PASSWORD SMOKE_ADMIN_EMAIL SMOKE_ADMIN_PASSWORD; do
      [ -n "${!var:-}" ] || missing+=("$var")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      warn "Some logged-in smoke checks will be skipped. Not set, and not in .env: ${missing[*]}"
    fi
  fi

  if bin/smoke "$APP_URL"; then
    ok "Smoke test passed"
  else
    fail "SMOKE TEST FAILED — the deployed app is broken. Roll back."
    exit 1
  fi
}

check_health() {
  step "Health check"

  # HEALTH_URLS is set with the target app, at the top.
  for url in "${HEALTH_URLS[@]}"; do
    info "Curling $url ..."

    local attempts=0
    local max_attempts=12
    local status

    while [ $attempts -lt $max_attempts ]; do
      status=$(curl -sL -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo "000")

      if [ "$status" = "200" ] || [ "$status" = "302" ]; then
        ok "$url returned HTTP $status"
        break
      fi

      attempts=$((attempts + 1))
      if [ $attempts -lt $max_attempts ]; then
        info "Got HTTP $status, retrying in 5s... ($attempts/$max_attempts)"
        sleep 5
      fi
    done

    if [ "$status" != "200" ] && [ "$status" != "302" ]; then
      fail "$url returned HTTP $status after $max_attempts attempts"
      exit 1
    fi
  done
}

# Solid Queue's supervisor starts with the worker dyno, and it can still
# fail to start, so ask the app: every process kind must have a fresh
# heartbeat (rake deploy:verify_solid_queue). Two tries, because the
# one-off dyno itself takes a while to boot and the first heartbeats may
# land after the health check passed.
check_solid_queue() {
  step "Solid Queue check"

  local attempt
  for attempt in 1 2; do
    if heroku run --exit-code bin/rake deploy:verify_solid_queue -a "$APP"; then
      ok "Solid Queue is running (supervisor, dispatcher, worker, scheduler)"
      return 0
    fi
    [ "$attempt" -eq 1 ] && { info "Not yet — retrying in 30s"; sleep 30; }
  done

  fail "Solid Queue is not running. Live updates and the nightly jobs are off until it is."
  info "Check: heroku ps -a $APP ; heroku logs -a $APP --dyno worker | grep SolidQueue ; and docs/runbooks/scheduler-cutover.md"
  exit 1
}

# A heartbeat says a process is alive, not that its work succeeds: on
# staging on 2026-10-20 the scheduler failed at every tick with fresh
# heartbeats. So queue a recurring task the way the scheduler does and
# wait for the worker to run it (rake deploy:verify_recurring_job). One
# try: the task itself waits up to two minutes for the worker.
check_recurring_job() {
  step "Recurring job check"

  if heroku run --exit-code bin/rake deploy:verify_recurring_job -a "$APP"; then
    ok "The worker ran a recurring task queued the way the scheduler queues it"
    return 0
  fi

  fail "Solid Queue is up, but a recurring task did not run. The nightly jobs and live updates may not run."
  info "Read the error above, then: heroku logs -a $APP --dyno worker | grep -i error"
  exit 1
}

# --- Main ---------------------------------------------------------------------

main() {
  bold "============================================"
  bold "  Comeals Deploy"
  bold "============================================"
  info "Target: $APP ($APP_URL)"

  preflight_environment
  preflight_repo
  preflight_ci

  if ! detect_deploy_needs; then
    echo
    green "============================================"
    green "  Already up to date — nothing to deploy."
    green "============================================"
    exit 0
  fi

  detect_pending_migrations
  check_database_not_behind

  preflight_quality

  # --- Confirmation ---
  echo
  bold "Deploy plan:"
  echo

  local sha
  sha=$(git rev-parse --short HEAD)
  if [ "$NEEDS_MAINTENANCE" = true ]; then
    yellow "    $APP ($sha):  MAINTENANCE deploy (has migrations)"
  else
    green "    $APP ($sha):  PUSH deploy (no migrations)"
  fi
  git log --oneline -5 | while IFS= read -r line; do
    info "  $line"
  done

  echo
  if [ "${DEPLOY_YES:-}" = "1" ]; then
    info "Proceeding without a prompt (--yes)"
  else
    printf "Continue? (y/n) "
    read -r confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      info "Aborted."
      exit 0
    fi
  fi

  DEPLOY_TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%S")

  read_release_before
  capture_backup

  if [ "$NEEDS_MAINTENANCE" = true ]; then
    enable_maintenance
    deploy_maintenance
    disable_maintenance
  else
    deploy_push
  fi

  info "Waiting 10s for dynos to settle..."
  sleep 10

  check_logs
  check_health
  check_solid_queue
  check_recurring_job
  run_smoke

  echo
  green "============================================"
  green "  Deploy complete!"
  green "============================================"
}

main "$@"
