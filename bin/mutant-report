#!/usr/bin/env ruby
# frozen_string_literal: true

# Adds up the pieces of a Mutant workflow run (.github/workflows/mutant.yml)
# and checks every survivor against config/mutant/accepted_survivors.yml.
# Each piece left a directory with subjects.txt and the session file mutant
# wrote (.mutant/results/<session>.json.gz), which holds every mutation and
# its result. Prints a Markdown report, for the run's summary, and writes
# the same to a file: the totals, each piece, each survivor that is not on
# the list (as an entry ready to fill in), and each entry that no longer
# survives.
#
# A piece with no session file did not finish: its machine was stopped, or
# mutant itself failed. Given the number of pieces the run started, the
# report also names each piece that left no directory at all: a machine
# that was stopped, as two were on 2026-10-16, uploads nothing.
#
# --full says the run had every subject in .mutant.yml, so an entry whose
# subject did not run names a method that was renamed or removed.
#
# Exits 1 when a survivor is not on the list, an entry no longer survives,
# or a piece has no result; 0 otherwise.
#
# Usage: bin/mutant-report [--full] [--pieces N] <directory of pieces> <report file>
#
# Ruby's standard library only: the workflow's last job runs it without
# the bundle.

require 'optparse'
require_relative 'lib/mutant_survivors'

Piece = Struct.new(:name, :subjects, :mutations, :runtime, :missing, keyword_init: true) do
  def ran? = !mutations.nil?
end

def read_piece(dir)
  subjects_path = File.join(dir, 'subjects.txt')
  subjects = File.exist?(subjects_path) ? File.readlines(subjects_path).size : 0
  sessions = Dir.glob(File.join(dir, '.mutant', 'results', '*.json.gz'))
  return Piece.new(name: File.basename(dir), subjects: subjects) if sessions.empty?

  mutations = sessions.flat_map { |path| MutantSurvivors.read_session(path) }
  runtime = sessions.sum { |path| JSON.parse(Zlib::GzipReader.open(path, &:read)).fetch('runtime') }
  Piece.new(name: File.basename(dir), subjects: subjects, mutations: mutations, runtime: runtime)
end

# A piece the run started that left no directory.
def missing_pieces(found, started)
  names = (0...started).map { |number| "mutant-piece-#{number}" } - found.map(&:name)
  names.map { |name| Piece.new(name: name, subjects: '', missing: true) }
end

def totals(mutations, pieces)
  alive = mutations.count(&:alive)
  killed = mutations.size - alive
  timed_out = mutations.count { |mutation| mutation.alive && mutation.timeout }
  share = mutations.empty? ? 0 : 100.0 * killed / mutations.size
  ["#{mutations.size} mutations, #{killed} killed, #{alive} alive, #{timed_out} timed out: " \
   "#{format('%.2f', share)}% killed.", *pieces_without_results(pieces)]
end

def pieces_without_results(pieces)
  stopped = pieces.reject { |piece| piece.ran? || piece.missing }.map(&:name).sort.join(', ')
  missing = pieces.select(&:missing).map(&:name).join(', ')
  lines = []
  lines << "Did not finish, so their subjects have no result: #{stopped}." unless stopped.empty?
  lines << "Left nothing, so their subjects have no result: #{missing}." unless missing.empty?
  lines
end

def pieces_table(pieces)
  rows = pieces.sort_by { |piece| piece.name[/\d+\z/].to_i }.map do |piece|
    cells = if piece.ran?
              [piece.mutations.size, piece.mutations.count(&:alive), "#{(piece.runtime / 60).round} min"]
            elsif piece.missing
              ['left nothing', '', '']
            else
              ['did not finish', '', '']
            end
    "| #{piece.name} | #{piece.subjects} | #{cells.join(' | ')} |"
  end
  ['## Pieces', '', '| Piece | Subjects | Mutations | Alive | Runtime |', '| --- | ---: | ---: | ---: | ---: |', *rows]
end

full = false
started = nil
parser = OptionParser.new do |options|
  options.banner = 'Usage: bin/mutant-report [--full] [--pieces N] <directory of pieces> <report file>'
  options.on('--full') { full = true }
  options.on('--pieces N', /\A\d+\z/) { |number| started = Integer(number, 10) }
end
begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn e.message, parser.banner
  exit 2
end
unless ARGV.size == 2
  warn parser.banner
  exit 2
end

dirs = Dir.children(ARGV[0]).map { |child| File.join(ARGV[0], child) }.select { |path| File.directory?(path) }
pieces = dirs.map { |dir| read_piece(dir) }
pieces += missing_pieces(pieces, started) if started
mutations = pieces.select(&:ran?).flat_map(&:mutations)
complete = pieces.all?(&:ran?)
# An entry whose subject was in a piece that did not finish is not stale,
# so only a run where every piece finished counts as full.
comparison = MutantSurvivors.compare(mutations, MutantSurvivors.read_list, full: full && complete, here: 'linux')
lines = ['# Mutant run', '', *totals(mutations, pieces), '', *pieces_table(pieces), '',
         *MutantSurvivors.report_lines(comparison)]
text = "#{lines.join("\n")}\n"
File.write(ARGV[1], text)
puts text
exit(comparison.passed? && complete ? 0 : 1)
