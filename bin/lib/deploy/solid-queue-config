#!/usr/bin/env bash
# The Deploy workflow's "Solid Queue config vars" step
# (.github/workflows/deploy.yml). Production's release phase refuses the
# promote without RAILS_DB_POOL >= 4, the pool the jobs dyno needs
# (lib/deploy_config_check.rb), so this sets it first, the way bin/deploy
# does. When it is already right, nothing is written and no dyno
# restarts.
#
# Reads PROD_APP.
set -euo pipefail

pool=$(heroku config:get RAILS_DB_POOL -a "$PROD_APP")
if [ "${pool:-0}" -ge 4 ] 2>/dev/null; then
  echo "RAILS_DB_POOL=$pool is set."
else
  echo "Setting RAILS_DB_POOL=4 (was '$pool')."
  heroku config:set RAILS_DB_POOL=4 -a "$PROD_APP"
fi
