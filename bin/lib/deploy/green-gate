#!/usr/bin/env bash
# The Deploy workflow's "Green gate" step (.github/workflows/deploy.yml).
# Every CI check on the candidate must have completed successfully. This
# run's own job is left out: it is attached to the same sha and would
# otherwise wait on itself.
#
# Reads CANDIDATE.
set -euo pipefail

# Reads "name|status|conclusion" lines, says which checks are not
# green, and sets bad to 1 if any is not.
report_runs() {
  while IFS='|' read -r name status conclusion; do
    if [ "$status" != "completed" ]; then
      echo "still running: $name"; bad=1
    elif [ "$conclusion" != "success" ] && [ "$conclusion" != "neutral" ] && [ "$conclusion" != "skipped" ]; then
      echo "$conclusion: $name"; bad=1
    fi
  done
}

sha="$CANDIDATE"
filter='.check_runs[] | select(.name != "daily-deploy") | "\(.name)|\(.status)|\(.conclusion // "pending")"'
runs=$(gh api "repos/{owner}/{repo}/commits/${sha}/check-runs" --paginate --jq "$filter")
if [ -z "$runs" ]; then
  echo "No CI runs found for $sha — refusing to deploy untested code."
  exit 1
fi
bad=0
report_runs <<< "$runs"
[ "$bad" -eq 0 ] || { echo "CI is not green for $sha."; exit 1; }
echo "All CI checks green."
