#!/usr/bin/env bash
# The Deploy workflow's "Watch production" step
# (.github/workflows/deploy.yml). Waits until production serves the
# candidate, smokes it, asks whether Solid Queue came up, and watches
# the logs for three minutes. On a failure it rolls back only the code,
# and only when the release ran no migration.
#
# A refused smoke login rolls back only when the smoke-before step
# proved that login worked before the promote (LOGIN_WORKED_BEFORE=true).
# Otherwise the run goes on with the other checks and fails at the end.
# A missing smoke secret does not stop the watch either: every check
# runs, and the step then ends with code 2.
#
# Reads CANDIDATE, PREVIOUS and STARTED (from the promote step),
# LOGIN_WORKED_BEFORE (from the smoke-before step), PROD_APP, PROD_URL
# and the four SMOKE_* secrets. Run from the repository root.
set -euo pipefail
. "$(dirname "$0")/../json.sh"
. "$(dirname "$0")/../smoke_secrets.sh"

missing_secrets=$(missing_smoke_secrets)

# The log lines logged at or after $1 (UTC, as 2026-10-19T12:00:00).
# Heroku log lines start with a UTC timestamp; compare as strings.
lines_since() { awk -v since="$1" '$1 >= since'; }

# The lines that fail the soak.
worrying_lines() { grep -iE "FATAL|status=5[0-9][0-9]| ERROR |Exception"; }

candidate="$CANDIDATE"
# The release before the worker dyno runs no Solid Queue. The new
# code's jobs must not go on running beside the old code, and after the
# rollback Heroku would refuse to scale a process type the release does
# not have, so the worker goes to 0 first. A Procfile that cannot be
# read counts as one without a worker: stopping the jobs is the safe
# side, and the next deploy starts them again.
stop_worker_unless_previous_has_one() {
  if git show "$PREVIOUS:Procfile" 2>/dev/null | grep -q '^worker:'; then
    return 0
  fi
  echo "The release before has no worker dyno, so the worker goes to 0 and stays there."
  heroku ps:scale worker=0 -a "$PROD_APP" \
    || echo "Could not stop the worker dyno. Run: heroku ps:scale worker=0 -a $PROD_APP"
}

# Rolls back only the code, and only when the release ran no
# migration: the old code may not run on what a migration made
# (#133). Otherwise production stays as it is, the run fails,
# and a person follows docs/runbooks/undo-a-deploy.md.
roll_back() {
  if bin/rollback-check "$PREVIOUS" "$candidate"; then
    stop_worker_unless_previous_has_one
    heroku rollback -a "$PROD_APP"
  else
    echo "Not rolling back only the code. Follow docs/runbooks/undo-a-deploy.md."
  fi
}
# Wait for the release (including its migration) to finish.
live=""
for _ in $(seq 1 60); do
  live=$(curl -sf "$PROD_URL/api/v1/version" | json "d.get('commit') or ''" || true)
  [ "$live" = "$candidate" ] && break
  sleep 5
done
if [ "$live" != "$candidate" ]; then
  echo "Production never started serving $candidate (still $live)."
  # A release phase that failed (a migration error) shows here as
  # a failed release.
  heroku releases -a "$PROD_APP" -n 3 || true
  # Only roll back if the new release actually became current.
  # If the promote's release phase failed, production never
  # moved, and a rollback would undo the previous GOOD release.
  current=$(heroku config:get HEROKU_SLUG_COMMIT -a "$PROD_APP")
  if [ "$current" = "$candidate" ]; then
    echo "The slug is current but not serving — rolling back."
    roll_back
  else
    echo "Production still runs the old release — nothing to roll back."
  fi
  exit 1
fi
echo "Production serves the candidate."
# A promote starts no dyno of a process type that is new or at 0, so
# the first promote whose release has a worker process type leaves the
# jobs off. When the worker already runs, this asks for the count it
# has.
if ! heroku ps:scale worker=1 -a "$PROD_APP"; then
  echo "Could not start the worker dyno on production. Rolling back."
  roll_back
  exit 1
fi
# bin/smoke ends with 2 when production answered and refused a smoke
# login. If that login worked before the promote, the release broke it,
# and it rolls back. If not, the secrets may just be out of date, and
# rolling back could undo a good release: the other checks still run,
# and still roll back a broken release, and the run fails at the end, so
# the release note stays a draft.
smoke_status=0
bin/smoke "$PROD_URL" || smoke_status=$?
if [ "$smoke_status" -eq 2 ] && [ "${LOGIN_WORKED_BEFORE:-}" = true ]; then
  echo "Production refused a smoke login that worked before the deploy, so the release broke it. Rolling back."
  roll_back
  exit 1
elif [ "$smoke_status" -eq 2 ]; then
  echo "Production refused a smoke login. It is not known to have worked before the deploy, so this is not a reason to roll back. The other checks go on."
elif [ "$smoke_status" -ne 0 ]; then
  echo "Smoke failed on production. Rolling back."
  roll_back
  exit 1
fi
# Live updates and the nightly jobs run in Solid Queue, whose
# supervisor starts with the worker dyno. This asks the app whether
# every process kind really came up.
# Twice, 30 seconds apart: the worker dyno can take longer to boot
# than the smoke test takes.
solid_queue_up=false
for attempt in 1 2; do
  if heroku run --exit-code bin/rake deploy:verify_solid_queue -a "$PROD_APP"; then
    solid_queue_up=true
    break
  fi
  if [ "$attempt" -eq 1 ]; then
    echo "Solid Queue is not up yet. Asking again in 30 seconds."
    sleep 30
  fi
done
if [ "$solid_queue_up" != true ]; then
  echo "Solid Queue is not running on production. Rolling back."
  roll_back
  exit 1
fi
# A heartbeat says a process is alive, not that its work succeeds. Queue
# a recurring task the way the scheduler does and wait (up to two
# minutes, inside the task) for the worker to run it.
if ! heroku run --exit-code bin/rake deploy:verify_recurring_job -a "$PROD_APP"; then
  echo "A recurring task queued on production did not run. Rolling back."
  roll_back
  exit 1
fi
# The soak: watch the logs for a few minutes of real traffic.
sleep 180
# Only lines logged after the promote began — the last 1500
# lines would include pre-deploy noise, and a stale error must
# not trigger a rollback of a healthy release.
# Logs that cannot be read fail the run, but do not roll back: the
# release passed the smoke test and the Solid Queue check, and a person
# decides.
if ! logs=$(heroku logs -n 1500 -a "$PROD_APP"); then
  echo "Could not read the production logs, so the soak cannot pass. Not rolling back."
  exit 1
fi
hits=$(lines_since "$STARTED" <<< "$logs" | worrying_lines || true)
if [ -n "$hits" ]; then
  echo "Worrying production log lines after the deploy:"
  echo "$hits" | head -20
  echo "Rolling back."
  roll_back
  exit 1
fi
echo "No worrying lines in the production logs."
if [ "$smoke_status" -eq 2 ]; then
  echo "Production passed every other check, but the smoke test could not sign in, so this run is not a pass and the release stays a draft. Check the SMOKE_* secrets of the GitHub environment production, then run: bin/smoke $PROD_URL"
  exit 1
fi
if [ -n "$missing_secrets" ]; then
  say_smoke_secrets_missing "$missing_secrets"
  exit 2
fi
