#!/usr/bin/env bash
# The Rollback workflow's "Say what to do by hand" step
# (.github/workflows/rollback.yml). It runs when an undo with a backup
# stopped part way, says which state production is in, and prints the
# commands to run by hand. It changes nothing.
#
# Reads RESTORE, ROLL and START (the outcomes of those steps), WEB_COUNT,
# TARGET, TARGET_HAS_WORKER, URL, APP and BACKUP.
# -eo pipefail, not -euo: a step's own shell on GitHub has no -u, and
# WEB_COUNT is empty when the restore step stopped before it set it.
set -eo pipefail

count="${WEB_COUNT:-1}"
echo "The undo stopped part way (see docs/runbooks/undo-a-deploy.md, \"If it stops half way\")."
if [ "$START" = "success" ]; then
  echo "The backup is restored, the old code runs, and web is up. Only maintenance mode"
  echo "may still be on. Run:"
  echo "  heroku maintenance:off -a $APP"
  echo "  bin/smoke $URL"
  exit 0
fi
echo "Maintenance mode is on. Web and the worker may be at 0: then no dyno runs and no"
echo "job runs. That is safe; nobody can write. This step did not start them again."
echo "Do not start them until the old code runs: the new code's jobs would run on the"
echo "restored database. Check with: heroku ps -a $APP; heroku releases -a $APP"
if [ "$RESTORE" != "success" ]; then
  echo "The step that stops web and restores the backup failed, so the database may or"
  echo "may not be restored. Check that a backup of the database as it was got captured"
  echo "(heroku pg:backups -a $APP), capture one if not, then run:"
  echo "  heroku ps:scale web=0 -a $APP"
  echo "  heroku ps:scale worker=0 -a $APP   (when heroku ps lists a worker)"
  echo "  (wait until heroku ps lists no web or worker dyno, and until this prints 0 or"
  echo "  says the table does not exist: no Solid Queue process sent a heartbeat lately)"
  echo "  heroku pg:psql -a $APP -c \"SELECT count(*) FROM solid_queue_processes WHERE last_heartbeat_at > (now() AT TIME ZONE 'UTC') - interval '75 seconds'\""
  echo "  heroku pg:backups:restore $BACKUP DATABASE_URL -a $APP --confirm $APP"
  echo "  heroku rollback $TARGET -a $APP"
elif [ "$ROLL" != "success" ]; then
  echo "The backup is restored, but the old code may not run yet. If heroku releases"
  echo "shows the rollback to $TARGET as failed or missing, run:"
  echo "  heroku rollback $TARGET -a $APP"
fi
echo "Then, once heroku releases shows the rollback to $TARGET succeeded:"
if [ "$TARGET_HAS_WORKER" = true ]; then
  echo "  heroku ps:scale worker=1 -a $APP"
else
  echo "  ($TARGET has no worker dyno: leave the worker at 0)"
fi
echo "  heroku ps:scale web=$count -a $APP"
echo "  heroku maintenance:off -a $APP"
echo "  bin/smoke $URL"
