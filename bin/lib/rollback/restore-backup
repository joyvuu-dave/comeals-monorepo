#!/usr/bin/env bash
# The Rollback workflow's "Stop the dynos and restore the backup" step
# (.github/workflows/rollback.yml). It turns maintenance on, captures
# the database as the new code left it, scales web and the worker to 0,
# waits until neither runs and no Solid Queue process is left
# (bin/lib/wait_until_stopped.sh), and restores the backup.
#
# Reads APP, BACKUP and HEROKU_API_KEY. Writes web_count (how many web
# dynos ran before) to $GITHUB_OUTPUT.
set -euo pipefail
. "$(dirname "$0")/../json.sh"
. "$(dirname "$0")/../wait_until_stopped.sh"

api() { curl -sf -H "Accept: application/vnd.heroku+json; version=3" -H "Authorization: Bearer $HEROKU_API_KEY" "$@"; }
heroku maintenance:on -a "$APP"
# The database as the new code left it, so the writes the restore
# takes away can still be read afterwards.
heroku pg:backups:capture -a "$APP"
formation=$(api "https://api.heroku.com/apps/$APP/formation")
# How many web dynos to start again after the rollback. The worker goes
# back to 1 in the Roll back step, when the release it goes back to has
# one.
web_count=$(json "sum(f['quantity'] for f in d if f['type'] == 'web')" <<< "$formation")
has_worker=$(json "str(any(f['type'] == 'worker' for f in d)).lower()" <<< "$formation")
echo "web_count=$web_count" >> "$GITHUB_OUTPUT"
# No job of the new code may run on the restored database, so the worker
# stops too. A release from before the worker dyno has no worker
# process type, and Heroku refuses to scale one.
if [ "$has_worker" = true ]; then
  echo "$APP runs $web_count web dyno(s) and a worker dyno. Scaling both to 0."
  heroku ps:scale web=0 worker=0 -a "$APP"
else
  echo "$APP runs $web_count web dyno(s) and no worker dyno. Scaling web to 0."
  heroku ps:scale web=0 -a "$APP"
fi
# Restore only when no process of the new code is left: no web or
# worker dyno, and no Solid Queue process still sending heartbeats.
if ! wait_until_stopped "$APP"; then
  echo "So the backup was not restored."
  exit 1
fi
echo "Restoring $BACKUP."
heroku pg:backups:restore "$BACKUP" DATABASE_URL -a "$APP" --confirm "$APP"
