#!/usr/bin/env bash
# The Rollback workflow's "Stop the web dyno and restore the backup"
# step (.github/workflows/rollback.yml). It turns maintenance on,
# captures the database as the new code left it, scales web to 0, waits
# until no web dyno runs, and restores the backup.
#
# Reads APP, BACKUP and HEROKU_API_KEY. Writes web_count (how many web
# dynos ran before) to $GITHUB_OUTPUT.
set -euo pipefail
. "$(dirname "$0")/../json.sh"

api() { curl -sf -H "Accept: application/vnd.heroku+json; version=3" -H "Authorization: Bearer $HEROKU_API_KEY" "$@"; }
heroku maintenance:on -a "$APP"
# The database as the new code left it, so the writes the restore
# takes away can still be read afterwards.
heroku pg:backups:capture -a "$APP"
# How many web dynos to start again after the rollback.
web_count=$(api "https://api.heroku.com/apps/$APP/formation/web" | json "d['quantity']")
echo "web_count=$web_count" >> "$GITHUB_OUTPUT"
echo "$APP runs $web_count web dyno(s). Scaling web to 0."
heroku ps:scale web=0 -a "$APP"
# A dyno takes up to 30 seconds to stop after ps:scale returns.
# Restore only when no web dyno runs, so no job is still running.
tries=0
while :; do
  running=$(heroku ps -a "$APP" --json | json "sum(1 for p in d if p['type'] == 'web')")
  if [ "$running" = "0" ]; then
    break
  fi
  tries=$((tries + 1))
  if [ "$tries" -ge 36 ]; then
    echo "A web dyno still runs 3 minutes after web was scaled to 0, so the backup was not restored."
    exit 1
  fi
  sleep 5
done
echo "No web dyno runs. Restoring $BACKUP."
heroku pg:backups:restore "$BACKUP" DATABASE_URL -a "$APP" --confirm "$APP"
