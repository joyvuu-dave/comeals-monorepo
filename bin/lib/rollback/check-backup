#!/usr/bin/env bash
# The Rollback workflow's "Check the backup" step
# (.github/workflows/rollback.yml). It runs before anything is changed,
# and refuses a backup that does not fit the code of the release it goes
# back to (#248):
#
# - A backup that has not run every migration that release's
#   db/structure.sql lists up to its db/production_schema_version.txt
#   (the release phase's rule, through bin/lib/schema-check). The
#   migrations up to that version were deleted from db/migrate/ after
#   production ran them. The rollback
#   runs the old code's release phase, and its db:migrate cannot run a
#   migration that has no file. So the old code would run on a database
#   without the tables and columns those migrations made. A release with
#   the squash guard (deploy:verify_schema_version) refuses such a
#   database, but only after the restore, with maintenance on and web at
#   0. A release from before the guard does not refuse it at all.
#   bin/deploy and the release phase use the same rule for the live
#   database, in the same words.
# - A backup with a migration newer than every version that release
#   knows: the old code would run on a schema made by newer code, which
#   is what the rollback is meant to undo.
# - A backup id that is not a plain id of this app's backups, such as
#   other-app::b042 or an address: heroku would restore another
#   database's data over this app's.
#
# It reads the backup's schema_migrations and nothing else: curl streams
# the backup into pg_restore, which writes out only that one table. The
# backup holds residents' personal data, so no part of it is written to
# disk, and the signed address of the backup is never printed.
#
# Reads APP, BACKUP, TARGET (the release, like v612) and TARGET_SHA (its
# commit). Run from the repository root, with that commit fetched, and
# with a pg_restore at least as new as the PostgreSQL that made the
# backup.
set -euo pipefail

file=db/production_schema_version.txt

# Heroku names a scheduled backup a<number> and one taken by hand (as
# bin/deploy does) b<number>, and resolves such an id among the backups of
# the app given with -a. Anything else (other-app::b042, an address, r012,
# which is a restore) can name another database, so it is refused before
# heroku is asked anything.
if ! [[ $BACKUP =~ ^[ab][0-9]+$ ]]; then
  echo "\"$BACKUP\" is not one of the backup ids of $APP. It must be an id that heroku pg:backups -a $APP lists,"
  echo "like b245: a backup of this app's own database. Nothing was changed."
  exit 1
fi

# A commit that is not here would look like one with no version file and
# no migrations, so check that first.
if ! git cat-file -e "$TARGET_SHA^{commit}"; then
  echo "The commit of $TARGET ($TARGET_SHA) is not in this checkout. Backup $BACKUP was not restored; nothing was changed."
  exit 1
fi

# The version the target commit's file names, when it has the file. A
# commit from before the file was added still holds every migration file
# back to 2017, so its release phase runs any migration the backup does
# not have.
squashed=
if git cat-file -e "$TARGET_SHA:$file" 2>/dev/null; then
  squashed=$(git show "$TARGET_SHA:$file" | grep -v -e '^#' -e '^[[:space:]]*$') || true
  if ! [[ $squashed =~ ^[0-9]{14}$ ]]; then
    echo "The $file of $TARGET must hold one version of 14 digits. Backup $BACKUP was not restored; nothing was changed."
    exit 1
  fi
fi

# The newest version the target code knows: its file's version, or the
# newest of its migration files, whichever is later.
known=${squashed:-0}
migrations=$(git ls-tree --name-only "$TARGET_SHA:db/migrate" 2>/dev/null) || true
while IFS= read -r name; do
  if [[ $name =~ ^([0-9]{14})_ ]] && [ "${BASH_REMATCH[1]}" -gt "$known" ]; then
    known=${BASH_REMATCH[1]}
  fi
done <<< "$migrations"
if [ "$known" = 0 ]; then
  echo "The commit of $TARGET has no $file and no migration file, so it is not known which database its code"
  echo "needs. Backup $BACKUP was not restored; nothing was changed."
  exit 1
fi

# What to print when the backup's versions cannot be read. The backup is
# not restored then: a backup nobody checked could be the one this step
# is here to refuse.
cannot_read() {
  echo "Could not read the migrations in backup $BACKUP of $APP: $1."
  echo "So the backup was not restored, and nothing was changed. docs/runbooks/undo-a-deploy.md"
  echo "says how to read them by hand."
  exit 1
}

url=$(heroku pg:backups:url "$BACKUP" -a "$APP") || cannot_read "heroku pg:backups:url failed"
if [[ $url != https://* ]]; then
  cannot_read "heroku pg:backups:url did not give an https address"
fi
# Anyone who can read the address can download the backup until it
# expires. The mask makes Actions print *** in its place, everywhere.
if [ "${GITHUB_ACTIONS:-}" = true ]; then
  echo "::add-mask::$url"
fi

# pg_restore stops reading once it has written schema_migrations, so curl
# then fails to write the rest and exits 23. That is not an error.
# pg_restore's own exit status says whether it read the table.
read_backup() {
  curl -sf "$url" | pg_restore --data-only --schema=public --table=schema_migrations -f -
  echo "statuses=${PIPESTATUS[*]}"
}
dump=$(read_backup)
unset url
statuses=${dump##*statuses=}
# What pg_restore wrote, without the newline before statuses=, which the
# <<< below adds back.
dump=${dump%statuses=*}
dump=${dump%$'\n'}
read -r curl_status restore_status <<< "$statuses"
if [ "$restore_status" != 0 ]; then
  cannot_read "pg_restore exited with $restore_status, and curl with $curl_status"
fi
if [ "$curl_status" != 0 ] && [ "$curl_status" != 23 ]; then
  cannot_read "curl exited with $curl_status"
fi

# The rows of the COPY block for schema_migrations, one version a line,
# ended by a line that is only \.
copying=false
ended=false
count=0
newest=0
versions=()
while IFS= read -r line; do
  if [ "$copying" = false ]; then
    [[ $line == COPY*schema_migrations* ]] && copying=true
    continue
  fi
  if [ "$line" = '\.' ]; then
    ended=true
    break
  fi
  if ! [[ $line =~ ^[0-9]{1,18}$ ]]; then
    cannot_read "schema_migrations holds a row that is not a version"
  fi
  count=$((count + 1))
  versions+=("$line")
  if [ "$line" -gt "$newest" ]; then
    newest=$line
  fi
done <<< "$dump"

if [ "$copying" = false ]; then
  cannot_read "it has no schema_migrations table"
fi
if [ "$ended" = false ]; then
  cannot_read "its schema_migrations data ended part way"
fi
# The live check lets a database with no migration through, because a
# new database gets its schema from db/structure.sql. A backup restored
# over production is never that: it would leave production empty.
if [ "$count" = 0 ]; then
  echo "Backup $BACKUP of $APP has run no migration, so it is not a copy of production's database."
  echo "It was not restored, and nothing was changed."
  exit 1
fi

# The release phase's rule (lib/squashed_migrations_check.rb, through
# bin/lib/schema-check), with the target commit's own version file and
# db/structure.sql: the backup must hold every migration that
# db/structure.sql lists up to that version, not only one as new.
if [ -n "$squashed" ]; then
  # A commit with no db/structure.sql gives the rule an empty file, which
  # it cannot read, so the backup is refused.
  structure=$(git show "$TARGET_SHA:db/structure.sql") || true
  rows=$(printf 'version=%s\n' "${versions[@]}")
  rule_script="$(dirname "$0")/../schema-check"
  status=0
  rule=$(ruby "$rule_script" <(echo "$squashed") <(echo "$structure") <<< "$rows"$'\nend=ok' 2>&1) || status=$?
  if [ "$status" = 1 ]; then
    echo "Backup $BACKUP does not fit the code of $TARGET."
    echo "$rule"
    echo "Backup $BACKUP was not restored, and nothing was changed."
    exit 1
  fi
  if [ "$status" != 0 ]; then
    echo "Could not check backup $BACKUP against the db/structure.sql of $TARGET: $rule"
    echo "So the backup was not restored, and nothing was changed."
    exit 1
  fi
fi
if [ "$newest" -gt "$known" ]; then
  echo "Backup $BACKUP has migration $newest, which the code of $TARGET does not know: the newest version it knows is"
  echo "$known. So the code of $TARGET would run on a schema made by newer code, which is what the rollback is meant"
  echo "to undo. Backup $BACKUP was not restored, and nothing was changed. Run this again with the backup bin/deploy"
  echo "took before the deploy that is being undone (its output names it), or with a newer release."
  exit 1
fi
echo "Backup $BACKUP has run $count migrations, the newest $newest, which is not newer than the newest version"
echo "the code of $TARGET knows ($known)."
if [ -n "$squashed" ]; then
  echo "It has run every migration the db/structure.sql of $TARGET lists up to its $file ($squashed) too."
else
  echo "The commit of $TARGET has no $file. It still holds every migration file, so its release phase"
  echo "runs any migration the backup does not have."
fi
