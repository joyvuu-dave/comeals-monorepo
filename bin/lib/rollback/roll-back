#!/usr/bin/env bash
# The Rollback workflow's "Roll back" step (.github/workflows/rollback.yml).
# Runs heroku rollback, waits for the release phase of the new release,
# checks that the running commit changed, and starts the worker dyno
# when that release has one.
#
# Reads APP, TARGET (a release, e.g. v612), BAD_SHA (the commit that
# ran before) and TARGET_HAS_WORKER ("true" when the release it goes
# back to has a worker process type). Writes bad_sha and live_sha to
# $GITHUB_OUTPUT.
set -euo pipefail
. "$(dirname "$0")/../json.sh"

bad_sha="$BAD_SHA"
# A release from before the worker dyno runs no Solid Queue. The new
# code's jobs must not go on running beside the old code, and after the
# rollback Heroku would refuse to scale a process type the release does
# not have, so the worker goes to 0 first. Heroku lists the formation
# as "web=1:Basic worker=1:Basic".
if [ "$TARGET_HAS_WORKER" != true ]; then
  echo "$TARGET has no worker dyno, so the worker stays at 0."
  if [[ " $(heroku ps:scale -a "$APP")" == *" worker="* ]]; then
    heroku ps:scale worker=0 -a "$APP"
  fi
fi
heroku rollback "$TARGET" -a "$APP"
# A rollback makes a new release, and Heroku runs the release
# phase for it (the old code's Procfile release line: rake
# db:migrate, or rake deploy:verify_config db:migrate in releases
# built from main between 2026-09-16 and 2026-10-20) in a one-off
# dyno, whatever the web formation is. If it
# fails, the release fails and the app keeps the new code. Wait
# for it, and stop before web is started again.
tries=0
while :; do
  status=$(heroku releases -a "$APP" --json | json "d[0]['status']")
  if [ "$status" != "pending" ]; then
    break
  fi
  tries=$((tries + 1))
  if [ "$tries" -ge 36 ]; then
    break
  fi
  sleep 5
done
if [ "$status" != "succeeded" ]; then
  echo "The release phase of the rollback did not succeed (status: $status). Its output:"
  heroku releases:output -a "$APP" | tail -30 || true
  exit 1
fi
live_sha=$(heroku config:get HEROKU_SLUG_COMMIT -a "$APP")
echo "bad_sha=$bad_sha" >> "$GITHUB_OUTPUT"
echo "live_sha=$live_sha" >> "$GITHUB_OUTPUT"
if [ "$live_sha" = "$bad_sha" ]; then
  echo "Rollback did not change the running slug."
  exit 1
fi
echo "$APP now runs $live_sha."
# After a restore the worker is at 0, and a worker at 0 stays at 0
# through a rollback. When it already runs, this asks for the count it
# has.
if [ "$TARGET_HAS_WORKER" = true ]; then
  heroku ps:scale worker=1 -a "$APP"
fi
