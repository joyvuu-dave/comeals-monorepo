# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Gems installed into the tree (CI's setup-ruby uses ./vendor/bundle).
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development
/storage/*

/public/assets
/public/vite-assets
/public/.vite/
/public/index.html
.byebug_history

# dotenv
.env

/public/packs
/public/packs-test
/node_modules

# Ignore master key for decrypting credentials and more.
/config/master.key

comeals.sublime-workspace

# Mac
.DS_Store

# RuboCop
.rubocop-cache/

# Heroku database dumps (production data — never commit)
latest.dump
*.dump

# SimpleCov coverage reports
/coverage/

# Playwright test results
/test-results/
/tests/test-results/

# AI tooling (Claude Code)
.claude/

# Working memory from the planning-with-files skill. Decisions worth keeping
# live in docs/adr/; these files are local scratch only.
/task_plan.md
/findings.md
/progress.md
